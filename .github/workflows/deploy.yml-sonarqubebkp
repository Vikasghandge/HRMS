name: Deploy HRMS Application

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main
  workflow_dispatch:

env:
  DOCKER_USERNAME: ${{ secrets.DOCKER_USERNAME }}
  IMAGE_TAG: ${{ github.sha }}

jobs:
  # JOB 1: SonarQube Analysis via GitHub Actions
  sonarqube:
    name: SonarQube Code Analysis
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v3
        with:
          fetch-depth: 0  # Full history for better analysis

      - name: SonarQube Scan
        uses: SonarSource/sonarqube-scan-action@master
        env:
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}

      # Optional: Wait for quality gate result
      - name: SonarQube Quality Gate check
        id: sonarqube-quality-gate-check
        uses: sonarsource/sonarqube-quality-gate-action@master
        timeout-minutes: 5
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
        continue-on-error: true

      - name: "Quality gate status"
        run: |
          if [ "${{ steps.sonarqube-quality-gate-check.outcome }}" == "failure" ]; then
            echo "❌ Quality Gate FAILED"
            exit 1
          else
            echo "✅ Quality Gate PASSED"
          fi

  # JOB 2: Build and Push Docker Images
  build:
    name: Build Docker Images
    needs: sonarqube  # Build only after SonarQube passes
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v3

      - name: Login to Docker Hub
        uses: docker/login-action@v2
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Build and Push Backend
        working-directory: ./backend
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-backend:${{ env.IMAGE_TAG }} .
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-backend:latest .
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-backend:${{ env.IMAGE_TAG }}
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-backend:latest

      - name: Build and Push Frontend
        working-directory: ./frontend
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-frontend:${{ env.IMAGE_TAG }} .
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-frontend:latest .
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-frontend:${{ env.IMAGE_TAG }}
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-frontend:latest

      - name: Build and Push File Upload Service
        working-directory: ./file-upload-service
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-file-upload:${{ env.IMAGE_TAG }} .
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-file-upload:latest .
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-file-upload:${{ env.IMAGE_TAG }}
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-file-upload:latest

      - name: Build and Push Notification Service
        working-directory: ./notification-service
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-notification:${{ env.IMAGE_TAG }} .
          docker build -t ${{ secrets.DOCKER_USERNAME }}/hrms-notification:latest .
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-notification:${{ env.IMAGE_TAG }}
          docker push ${{ secrets.DOCKER_USERNAME }}/hrms-notification:latest

  # JOB 3: Deploy to Server
  deploy:
    name: Deploy to Production Server
    needs: build
    runs-on: ubuntu-latest

    steps:
      - name: Deploy to Server
        uses: appleboy/ssh-action@v0.1.10
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          port: 22
          script: |
            cd /home/ubuntu/HRMS || exit 1
            docker compose pull
            docker compose down
            docker compose up -d
            docker image prune -af
            docker compose ps

      - name: Health Check
        run: |
          echo "Waiting 30 seconds for services to start..."
          sleep 30
          echo "Checking if server is responding..."
          curl -f http://${{ secrets.SERVER_HOST }} || echo "Warning: Health check failed"

  # JOB 4: Notify on Completion
  notify:
    name: Send Notification
    needs: deploy
    runs-on: ubuntu-latest
    if: always()

    steps:
      - name: Notify Deployment Status
        run: |
          if [ "${{ needs.deploy.result }}" == "success" ]; then
            echo "✅ Deployment successful!"
            echo "🚀 HRMS Application is now live!"
            echo "📊 View SonarQube report: ${{ secrets.SONAR_HOST_URL }}/projects"
          else
            echo "❌ Deployment failed!"
            echo "⚠️ Please check the logs above for errors."
            if [ "${{ needs.sonarqube.result }}" == "failure" ]; then
              echo "🔍 Code quality gate failed. Check SonarQube for details."
            fi
          fi
